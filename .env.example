# Onlinedurst Heilbronn - Production Environment Variables
# Copy this file to .env and fill in the values

# Database (PostgreSQL)
POSTGRES_DB=onlinedurst
POSTGRES_USER=vendure
POSTGRES_PASSWORD=your-secure-database-password

# Vendure Server
COOKIE_SECRET=generate-with-openssl-rand-base64-32
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=your-secure-admin-password

# CORS - Allowed origins for API requests (comma-separated)
CORS_ORIGINS=https://onlinedurst.de,https://www.onlinedurst.de

# Asset URL prefix for production
ASSET_URL_PREFIX=https://onlinedurst.de/assets/

# Storefront URL
STOREFRONT_URL=https://onlinedurst.de

# Email configuration
EMAIL_FROM_ADDRESS="Onlinedurst Heilbronn" <noreply@onlinedurst.de>

# Storefront cache revalidation secret
REVALIDATION_SECRET=generate-with-openssl-rand-base64-32

# SMTP Configuration (for production emails)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
